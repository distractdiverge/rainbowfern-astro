---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UserImage from '../assets/AllieLooktoFront.webp?url';

const siteTitle = 'Contact | Rainbow Fern Development';
const siteDescription = 'Available for architecture consulting, enterprise integration, and technical leadership projects. Remote services for Philadelphia Area and nationwide clients.';

const emailUser = 'the.astrid.solveig';
const emailDomain = 'gmail.com';
const fullEmail = `${emailUser}@${emailDomain}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/fern-colors.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <title>{siteTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rainbowfern.com/contact" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content="/fern-colors.svg" />

    <script type="application/ld+json">
      {`{
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "name": "Contact",
        "url": "https://rainbowfern.com/contact",
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "${fullEmail}",
          "contactType": "technical support"
        }
      }`}
    </script>
  </head>
  <body class="bg-white">
    <div class="grid grid-cols-12 gap-0 justify-stretch min-h-screen">
      <div class="col-span-12">
        <Header client:ignore />
      </div>
      <div class="hidden md:block md:col-span-1">&nbsp;</div>
      <div class="col-span-12 md:col-span-10 p-2 lg:p-4">
        <div class="py-10 px-5 max-w-6xl mx-auto text-gray-800">
          <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-start mb-12">
            {/* Text Content */}
            <div class="md:pr-8">
              <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900">Contact</h1>
              <p class="text-lg md:text-xl text-gray-600 mb-6">
                Let's Build Something Impactful Together.
              </p>
              <p class="text-gray-700 leading-relaxed">
                Reach out for architecture consulting, technical leadership, or collaboration on exciting projects.
              </p>
              <p class="mt-4 text-gray-600">
                Email: <a href={`mailto:${fullEmail}`} class="text-blue-600 hover:underline">{fullEmail}</a>
              </p>
              <div class="flex gap-4 mt-6">
                <a href="https://www.linkedin.com/in/alexlapinski/" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-500 hover:text-blue-600">
                  LinkedIn
                </a>
                <a href="https://pangea.app/profile/allie-lapinski" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-500 hover:text-blue-600">
                  Pangea
                </a>
                <a href="https://github.com/distractdiverge" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-500 hover:text-blue-600">
                  GitHub
                </a>
              </div>
            </div>

            {/* Image + Form */}
            <div>
              <img src={UserImage} alt="Astrid (Alex) Lapinski" class="w-full max-w-[200px] rounded-lg mb-6" />

              {/* Simple mailto form - no JS needed, server-rendered */}
              <form action="mailto:${fullEmail}" method="POST" enctype="text/plain" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First name</label>
                    <input type="text" name="First Name" id="firstName" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                  </div>
                  <div>
                    <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last name</label>
                    <input type="text" name="Last Name" id="lastName" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                  </div>
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
                  <input type="email" name="Email" id="email" required placeholder="email@janesfakedomain.net" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                </div>
                <div>
                  <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Your message</label>
                  <textarea name="Message" id="message" rows={4} placeholder="Enter your question or message" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"></textarea>
                </div>
                <div>
                  <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-lg font-medium text-white bg-gray-900 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-800 transition duration-150 ease-in-out">
                    Send Email
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
      <div class="hidden md:block md:col-span-1"></div>
      <div class="col-span-12 max-width-mx">
        <Footer client:ignore />
      </div>
    </div>
  </body>
</html>
