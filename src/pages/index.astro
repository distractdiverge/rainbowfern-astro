---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServicesHero from '../components/ServicesHero.astro';
import AboutHeroImage from '../assets/AllieLooktoSide.webp?url';

const siteTitle = 'Astrid (Alex) Lapinski | Software Architecture & Integration';
const siteDescription = 'Remote software architect & consultant in Philadelphia Area. 15+ years in fintech/healthcare. Enterprise architecture, system integration, technical leadership.';

const currentProjects = [
  { name: 'Portfolio Website', desc: 'This site itself. Building out a new professional portfolio website.', link: '/projects' },
  { name: 'Receipt Parser', desc: 'A series of python scripts and integration with AI models to parse out receipts for budgeting.' },
  { name: 'Statement Summarizer', desc: 'A set of python scripts to extract data from bank statements and summarize.' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/fern-colors.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <meta name="author" content="Astrid (Alex) Lapinski" />
    <title>{siteTitle}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rainbowfern.com/" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content="/fern-colors.svg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content="https://rainbowfern.com/" />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={siteDescription} />
    <meta property="twitter:image" content="/fern-colors.svg" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {`{
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Astrid (Alex) Lapinski",
        "url": "https://rainbowfern.com",
        "jobTitle": "Software Architect",
        "description": "Remote software architect & consultant in Philadelphia Area. 15+ years in fintech/healthcare.",
        "sameAs": [
          "https://www.linkedin.com/in/alexlapinski/",
          "https://github.com/distractdiverge"
        ]
      }`}
    </script>
  </head>
  <body class="bg-white">
    <div class="grid grid-cols-12 gap-0 justify-stretch min-h-screen">
      <div class="col-span-12">
        <Header client:ignore />
      </div>
      <div class="hidden md:block md:col-span-1">&nbsp;</div>
      <div class="col-span-12 md:col-span-10 p-2 lg:p-4">
        <div class="bg-white pl-8 pr-5 md:pl-12 pt-8">
          <h1 class="text-3xl font-semibold pb-8">Rainbow Fern Consulting</h1>
          <div>
            <img src={AboutHeroImage} alt="Astrid (Alex) Lapinski" class="float-left mr-5 mb-5 w-[37%] md:w-[40%] md:float-right md:ml-8 rounded-lg lg:max-w-[300px]" />
            <p class="mb-5 text-sm">Hi! I&apos;m Astrid (I also go by Alex), founder of Rainbow Fern consulting.</p>
            <p class="mb-5 text-sm">I have worked in the software field for the last 15+ years working up the corp ladder from intern to architect.</p>
            <p class="mb-5 text-sm">Now, I am focusing on taking on remote projects, mentoring and helping develop amazing test automation suites.</p>
            <p class="pb-5 text-sm">Take a look below at some recent projects, or details on what I offer as services.</p>
            <p class="clear-left md:clear-right size-0">&nbsp;</p>
          </div>
        </div>

        <section id="current-projects-hero" class="my-18">
          <h2 class="text-md font-semibold mb-5">Current Projects</h2>
          <div class="flex gap-0">
            <div class="w-1/3">
              <h3 class="text-sm font-bold mb-2">{currentProjects[0].name}</h3>
              <p class="text-xs text-gray-600 pr-5">{currentProjects[0].desc}</p>
            </div>
            <div class="w-1/3">
              <h3 class="text-sm font-bold mb-2">{currentProjects[1].name}</h3>
              <p class="text-xs text-gray-600 pr-5">{currentProjects[1].desc}</p>
            </div>
            <div class="w-1/3">
              <h3 class="text-sm font-bold mb-2">{currentProjects[2].name}</h3>
              <p class="text-xs text-gray-600 pr-5">{currentProjects[2].desc}</p>
            </div>
          </div>
          <a
            href="/projects"
            class="inline-block bg-gray-600 text-white text-sm mt-4 px-6 py-2 rounded-md hover:bg-gray-400 hover:text-gray-700 transition-colors"
          >
            See My Projects
          </a>
        </section>

        <div class="w-auto">
          <div class="border-gray-200 border-t p-4">&nbsp;</div>
        </div>

        <ServicesHero />
      </div>
      <div class="hidden md:block md:col-span-1"></div>
      <div class="col-span-12 max-width-mx">
        <Footer client:ignore />
      </div>
    </div>
  </body>
</html>
