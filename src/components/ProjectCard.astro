---
import { Markdown } from 'astro:content';

export interface Props {
  name: string;
  description: string;
  imageUrl?: string;
  detailsUrl?: string;
  githubUrl?: string;
  imagePosition?: 'left' | 'right';
}

const {
  name,
  description,
  imageUrl = 'https://picsum.photos/id/42/600/400',
  detailsUrl,
  githubUrl,
  imagePosition = 'left',
} = Astro.props;

const imageOrderClass = imagePosition === 'left'
  ? 'md:order-2'
  : 'md:order-1';

const detailsOrderClass = imagePosition === 'left'
  ? 'md:order-2'
  : 'md:order-1';
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 py-8">
  <div class={`order-1 ${imageOrderClass}`}>
    <img src={imageUrl} alt={`${name} project`} class="w-full h-auto block rounded-lg" />
  </div>
  <div class={`order-2 ${detailsOrderClass}`}>
    <h2 class="text-2xl font-semibold text-gray-800 mb-2">{name}</h2>
    <p class="text-base text-gray-700 leading-relaxed mb-5">{description}</p>
    <div class="flex items-center gap-3 mt-auto">
      {detailsUrl ? (
        <a
          href={detailsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="py-2 px-4 rounded-md font-semibold text-center bg-black text-white border border-black hover:bg-gray-800 transition-colors duration-300"
        >
          Details
        </a>
      ) : null}
      {githubUrl ? (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="py-2 px-4 rounded-md font-semibold text-center bg-gray-100 text-gray-800 border border-gray-300 hover:bg-gray-200 transition-colors duration-300"
        >
          Github Repo
        </a>
      ) : null}
    </div>
  </div>
</div>
